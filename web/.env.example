# Salin ke .env.local lalu isi. Hanya dua variabel pertama yang wajib untuk pengembangan lokal.

# Postgres dari docker-compose.yml di root repo.
DATABASE_URL=postgres://arabic:arabic@127.0.0.1:55432/arabic?sslmode=disable
# Buat dengan: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Opsional: login Google (wajib untuk membuka halaman admin).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email admin, dipisah koma. Admin harus masuk lewat Google.
ADMIN_EMAILS=

# Opsional: kirim email (SMTP).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_REPLY_TO=

# Opsional: server Whisper untuk penilaian ucapan.
STT_URL=
STT_TOKEN=
# Root CA (PEM) server Whisper bila memakai sertifikat internal; baris baru boleh ditulis sebagai \n.
STT_CA_CERT=

# Opsional: Azure TTS, hanya untuk membuat audio baru (content-src/build_orisinal.py --audio).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
